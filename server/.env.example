# PostgreSQL (required)
# Local docker-compose default:
#   docker compose up -d postgres
DATABASE_URL=postgres://roshdyar:roshdyar@127.0.0.1:5432/roshdyar
PORT=5000
NODE_ENV=production

# Optional: import once from a legacy SQLite file, then unset.
# SQLITE_PATH=/var/www/roshdyar/server/data/roshdyar.db

# SMS.ir OTP delivery
# Prefer Verify template (recommended for OTP). Create a template in sms.ir panel
# with a parameter like #CODE# and put its numeric id in SMS_TEMPLATE_ID.
SMS_PROVIDER=sms.ir
SMS_API_KEY=YOUR_SMS_IR_API_KEY
SMS_LINE_NUMBER=9830002108030648
# SMS_TEMPLATE_ID=123456
# SMS_TEMPLATE_PARAM=CODE
