# SQLite database file path (optional)
# SQLITE_PATH=/var/www/roshdyar/server/data/roshdyar.db
PORT=5000

# Optional SMS / OTP delivery
# Until SMS_API_KEY is set, OTP codes are logged to the server console
# and returned as devOtp in non-production responses for local testing.
# SMS_API_KEY=
# SMS_PROVIDER=console
# NODE_ENV=development
