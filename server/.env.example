# Relational SQLite database (WAL, indexed tables). Use a durable disk path in production.
# SQLITE_PATH=/var/www/roshdyar/server/data/roshdyar.db
PORT=5000
NODE_ENV=production

# PostgreSQL. Put this in server/.env (do not rely on a one-line shell assignment).
# Password must be English letters/numbers only — no Persian characters.
# DATABASE_URL=postgres://roshdyar:ASCII_PASSWORD@127.0.0.1:5432/roshdyar
# Then: bash scripts/migrate-postgres.sh
# PG_POOL_SIZE=20

# JWT auth. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# JWT_TTL=7d
# BCRYPT_ROUNDS=10
# AUTH_RATE_LIMIT=20
# AUTH_ALLOW_LEGACY_HEADER=0

# After Postgres is live and health shows engine=postgresql, cluster with:
#   PM2_INSTANCES=max pm2 start /var/www/roshdyar/ecosystem.config.js

# SMS.ir OTP delivery
# Prefer Verify template (recommended for OTP). Create a template in sms.ir panel
# with a parameter like #CODE# and put its numeric id in SMS_TEMPLATE_ID.
SMS_PROVIDER=sms.ir
SMS_API_KEY=YOUR_SMS_IR_API_KEY
SMS_LINE_NUMBER=9830002108030648
# SMS_TEMPLATE_ID=123456
# SMS_TEMPLATE_PARAM=CODE
